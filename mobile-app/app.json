{
  "expo": {
    "name": "QR Auth",
    "slug": "qr-auth",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "android": {
      "permissions": ["CAMERA"],
      "package": "com.qrauth.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "QR Auth necesita acceso a la cámara para escanear códigos QR y autenticar tu sesión de forma segura."
        }
      ]
    ]
  }
}